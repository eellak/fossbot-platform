      "example": "just_rotate('right')",
      "name": "just_rotate",
      "signature": "just_rotate(direction: 'left' | 'right') -> None"
    },
    {
      "constraints": [],
      "description": "Stop continuous robot motion.",
      "example": "stop()",
      "name": "stop",
      "signature": "stop() -> None"
    },
    {
      "constraints": [
        "axis must be x, y, or z"
      ],
      "description": "Read acceleration for one axis.",
      "example": "x = get_acceleration('x')",
      "name": "get_acceleration",
      "signature": "get_acceleration(axis: 'x' | 'y' | 'z') -> number"
    },
    {
      "constraints": [],
      "description": "Read the light sensor.",
      "example": "light = get_light_sensor()",
      "name": "get_light_sensor",
      "signature": "get_light_sensor() -> number"
    },
    {
      "constraints": [
        "axis must be x, y, or z"
      ],
      "description": "Read gyroscope data for one axis.",
      "example": "z = get_gyroscope('z')",
      "name": "get_gyroscope",
      "signature": "get_gyroscope(axis: 'x' | 'y' | 'z') -> number"

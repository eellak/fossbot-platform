      "example": "rotate_clockwise()",
      "name": "rotate_clockwise",
      "signature": "rotate_clockwise() -> None"
    },
    {
      "constraints": [],
      "description": "Rotate one degree counterclockwise.",
      "example": "rotate_counterclockwise()",
      "name": "rotate_counterclockwise",
      "signature": "rotate_counterclockwise() -> None"
    },
    {
      "constraints": [
        "returns 3 when no obstacle is detected"
      ],
      "description": "Read the nearest front obstacle distance.",
      "example": "distance = get_obstacle_distance()",
      "name": "get_obstacle_distance",
      "signature": "get_obstacle_distance() -> number"
    },
    {
      "constraints": [
        "supported UI colors include red, green, blue, white, violet, and off"
      ],
      "description": "Set the robot RGB light.",
      "example": "rgb_set_color('green')",
      "name": "rgb_set_color",
      "signature": "rgb_set_color(color: string) -> None"
    },
    {
      "constraints": [
        "frequency is Hz",
        "duration is milliseconds"
      ],
      "description": "Play a buzzer tone.",
      "example": "buzzer_beep(440, 200)",
      "name": "buzzer_beep",
      "signature": "buzzer_beep(frequency_hz: number, duration_ms: number) -> None"
    },
    {
      "constraints": [],
      "description": "Enable or disable drawing a trail.",
      "example": "draw(True)",
      "name": "draw",
      "signature": "draw(status: boolean) -> None"
    },
    {
      "constraints": [
        "call stop() to stop"
      ],

      "example": "move_forward_distance(0.5)",
      "name": "move_forward_distance",
      "signature": "move_forward_distance(distance: number) -> None"
    },
    {
      "constraints": [
        "direction must be forward or backward"
      ],
      "description": "Move one fixed 0.4-unit step.",
      "example": "move_step('forward')",
      "name": "move_step",
      "signature": "move_step(direction: 'forward' | 'backward') -> None"
    },
    {
      "constraints": [
        "distance is converted to an absolute value"
      ],
      "description": "Move backward by a distance in simulator units.",
      "example": "move_reverse_distance(0.5)",
      "name": "move_reverse_distance",
      "signature": "move_reverse_distance(distance: number) -> None"
    },
    {
      "constraints": [
        "direction must be left or right"
      ],
      "description": "Rotate 90 degrees.",
      "example": "rotate_90('left')",
      "name": "rotate_90",
      "signature": "rotate_90(direction: 'left' | 'right') -> None"
    },
    {
      "constraints": [
        "direction must be left or right"
      ],
      "description": "Rotate 45 degrees.",
      "example": "rotate_45('right')",
      "name": "rotate_45",
      "signature": "rotate_45(direction: 'left' | 'right') -> None"
    },
    {
      "constraints": [
        "positive and negative angles are supported"
      ],
      "description": "Rotate by an angle in degrees.",
      "example": "rotate_degrees(30)",
      "name": "rotate_degrees",
      "signature": "rotate_degrees(angle: number) -> None"
    },
    {
      "constraints": [],

[Unit]
Description=Assign a permanent random FOSSBot hostname on first boot
After=local-fs.target
Before=network-pre.target NetworkManager.service systemd-networkd.service avahi-daemon.service
Wants=network-pre.target
ConditionPathExists=!/var/lib/fossbot/hostname-initialized

[Service]
Type=oneshot
ExecStart=/usr/local/lib/fossbot/assign-hostname.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

